# 1 = real orders. Leave 0 for dry-run (same code path, simulated fills).
LIVE=0
# --- only needed for LIVE=1 ---
# Polymarket: Settings -> Export private key. Never share it.
PRIVATE_KEY=
# Polymarket wallet address shown on your profile (the deposit wallet, not the key's own address)
FUNDER=
# 3 = any account made since May 2026 (deposit wallet); 1 = older email/Google, 2 = older MetaMask, 0 = plain wallet
SIGNATURE_TYPE=3

# --- what to trade (defaults shown) ---
COINS=btc,eth,sol,doge,xrp,bnb
SPANS=5m,15m,1h,4h
SIZE=10
# dry-run play money (live uses the real USDC balance)
BALANCE=100

# 0.0.0.0 = dashboard reachable from outside
DASH_HOST=127.0.0.1
# dry-run order delay in seconds (measure: curl -w %{time_starttransfer} https://clob.polymarket.com/time)
LATENCY=0.12
# seconds a side must stay >= 0.98 before we bid
STEADY=20
# dashboard port
PORT=8000




# LIVE=1
# PRIVATE_KEY=0x...     # key of the 0xb1f5… address, typed on the server only
# FUNDER=0x5b3cC9A2769D51ba0ab6a9ef0822ed91d7f0812b
# SIGNATURE_TYPE=3
# COINS=btc
# SPANS=5m,15m
# SKIP=eth-1h          # coin-window pairs not to trade
# SIZE=5
# optional filters (0 = off): skip unless Binance shows the coin MIN_Z std-devs and MIN_MOVE % past its window open, our way
MIN_Z=0
MIN_MOVE=0
# cancel a waiting bid when Binance moves this % against it within 3 s (0 = off)
PULL=0
# after-close test (dry run only): buy the side Binance says won, at asks up to this price, in the minute after the close (0 = off)
AFTER=0
# price we bid, and the side's bid it must hold before we join (defaults 0.99 / 0.98)
BID=0.99
MIN_PRICE=0.98
