# 1 = real orders. Leave 0 for dry-run (same code path, simulated fills).
LIVE=0
# --- only needed for LIVE=1 ---
# Polymarket: Settings -> Export private key. Never share it.
PRIVATE_KEY=
# Polymarket wallet address shown on your profile
FUNDER=
# 1 = email/Google login, 2 = browser wallet (MetaMask), 0 = plain EOA
SIGNATURE_TYPE=1

# --- what to trade (defaults shown) ---
COINS=btc,eth,sol,doge,xrp,bnb
SPANS=5m,15m,1h,4h
SIZE=10
# dry-run play money (live uses the real USDC balance)
BALANCE=100

# 0.0.0.0 = dashboard reachable from outside
DASH_HOST=127.0.0.1
# dry-run order delay in seconds (measure: curl -w %{time_starttransfer} https://clob.polymarket.com/time)
LATENCY=0.07
